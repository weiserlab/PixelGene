#!/bin/bash
#PBS -N pasd
#PBS -l walltime=03:00:00
#PBS -l select=1:ncpus=36:mpiprocs=1:ompthreads=36:mem=250gb:ngpus=1

cd $PBS_O_WORKDIR

module load Miniconda3/24.7.1-0

source activate /scratch/e0007512/env

SIZEARR=(32 1024)
for SIZE in "${SIZEARR[@]}"; do
    for i in $(seq 1 6); do
        TAG="Strawberry19_size${SIZE}_rep${i}"
        python test_pasd_NVDIA.py \
        --pasd_model_path runs/pasd_light_color/checkpoint-180000 \
        --control_type grayscale \
        --high_level_info caption \
        --use_pasd_light \
        --image_path ./datasets/test_black/Strawberry19.jpg \
        --output_dir output/timestamp \
        --process_size "$SIZE" \
        --num_inference_steps 50 \
        --mixed_precision no \
        --use_blip \
        --output_tag "$TAG"
        echo "DONE  $TAG rc=$? at $(date '+%F %T')"
    done
done