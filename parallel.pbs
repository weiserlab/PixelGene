#!/bin/bash
#PBS -N pasd
#PBS -l walltime=15:00:00
#PBS -l select=1:ncpus=36:mpiprocs=1:ompthreads=36:mem=250gb:ngpus=1

cd $PBS_O_WORKDIR

module load Miniconda3/24.7.1-0

source activate /scratch/e0007512/env

CAP=./examples/captures
EVENTS=(
  "2026-10-17_14-39-35_event5"
  "2026-10-17_14-41-52_event6"
  "2026-10-17_14-46-21_event7"
)

for EV in "${EVENTS[@]}"; do
    DIR="$CAP/$EV"
    if [ ! -d "$DIR" ]; then
        echo "MISSING $DIR (cwd $(pwd))"
        continue
    fi
    TAG="${EV}_size512_chromaConfidence_opticalflow_swapconfidence_CaptionColored"
    python test_pasd_sequence.py \
    --pasd_model_path runs/pasd_light_color/checkpoint-180000 \
    --control_type grayscale \
    --high_level_info caption \
    --use_pasd_light \
    --image_path "$DIR" \
    --output_dir output/captures \
    --process_size 512 \
    --num_inference_steps 50 \
    --mixed_precision no \
    --use_blip \
    --chroma_prop 1 \
    --chroma_by_confidence 1 \
    --realisr_keep_chroma 1 \
    --output_tag "$TAG" \
    --save_debug \
    --color_prompt "colored"
    echo "DONE  $TAG rc=$? at $(date '+%F %T')"
done
