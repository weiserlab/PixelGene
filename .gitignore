# Whitelist: ignore everything at the top level, then allow only what should be pushed.
/*

# --- Repo basics ---
!/.gitignore
!/README.md
!/LICENSE

# --- Python code ---
!/*.py
!/pasd/

# --- Results ---
!/examples/
!/output/
!/quality_report.html
!/report_colorization.html

# --- Project records ---
!/meeting slides/
!/eoFiles/
!/Claude outputs/

# --- Environment / cluster ---
!/*.yml
!/requirements*.txt
!/parallel.pbs

# --- Never push, even inside allowed folders ---
__pycache__/
*.py[cod]
*.bak
*.log
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
